node_modules
/build
/.svelte-kit
/dev-dist
/package
.env
.env.*
!.env.example
# Налаштування емулятора секретів не містять: проєкт `demo-*` не існує ніде,
# крім локальної машини. Файл у репозиторії — щоб `npm run dev` працював одразу
# після клону, без окремого кроку «створіть .env».
!.env.development
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Звіти прогонів — не артефакт репозиторію.
/test-results
/playwright-report
/coverage
*-debug.log
firebase-debug.log
database-debug.log

# Передсмертні файли JVM. Емулятор бази — java-процес, і коли машині бракує
# памʼяті, він лишає в КОРЕНІ репозиторію `hs_err_pid*.log` на кілька сотень
# кілобайтів плюс `replay_pid*.log`. Під `*-debug.log` вони не підпадають, тож
# наступний `git add -A` затягнув би їх у коміт разом із роботою.
hs_err_pid*.log
replay_pid*.log

# Тимчасові скрипти агента. Лежать ТУТ, а не в корені: файл `*.mjs` у корені
# потрапляє під eslint і червонить базову лінію (PIT-TEMP-SCRIPTS).
/.private

# Збірка нативної частини — гігабайти проміжних файлів.
/src-tauri/target
/src-tauri/gen
