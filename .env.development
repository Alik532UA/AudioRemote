# Розробка йде на ЛОКАЛЬНОМУ ЕМУЛЯТОРІ, а не в бойовому проєкті Firebase.
#
# Тут немає секретів: `demo-audioremote` — спеціальний префікс, який емулятор
# приймає без жодних ключів і який не існує в хмарі. Саме тому файл лежить у
# репозиторії: інакше `npm run dev` після клону не піднявся б, і кожен починав
# би з питання «а де взяти конфіг».
#
# Бойові значення прийдуть зі змінних середовища в `deploy.yml`, коли з'явиться
# справжній проєкт. Цей файл тоді не змінюється — він читається лише в dev.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-audioremote
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9020?ns=demo-audioremote
