// ПРАВИЛА REALTIME DATABASE — ЄДИНА МЕЖА БЕЗПЕКИ ЦЬОГО ЗАСТОСУНКУ.
//
// Публічний конфіг Firebase за побудовою лежить у бандлі: адресу бази знає
// кожен, хто відкрив сайт. Усе, що робить із базою наш код, може зробити
// будь-хто тим самим SDK із консолі браузера — повз наш інтерфейс, нашу
// валідацію й наші перевірки. Отже єдине, що стоїть між відвідувачем і чужою
// дошкою, — цей файл.
//
// ПЕРЕВІРЯЄТЬСЯ ГЕЙТОМ, А НЕ ОЧИМА: `npm run check:rules` піднімає емулятор і
// проганяє два набори випадків — «застосунок мусить це вміти» й «сторонній не
// мусить цього могти». Правила «дозволити все» валять другий набір, «заборонити
// все» — перший, тож зелений результат неможливий випадково.
//
// ─── ЯК ТУТ ПРАЦЮЄ ПАРОЛЬ ────────────────────────────────────────────────────
//
// Правила бачать лише auth і ШЛЯХ. Передати їм «пароль, який я щойно ввів»
// неможливо — тому пароль тут і НЕ перевіряється правилом. Замість цього він
// ВХОДИТЬ В АДРЕСУ: дошка живе за boards/{hex}, де hex — хеш від пари
// (ідентифікатор, пароль), див. src/lib/board/boardPath.ts. Неправильний пароль
// дає інший хеш, тобто шлях, за яким нічого немає.
//
// Щоб це працювало, потрібна ще одна річ, і вона тут головна: **перелічити
// boards не можна**. Дозвіл читати стоїть лише на КОНКРЕТНІЙ дошці, а на самій
// гілці boards його немає — тож GET /boards відкидається, і зібрати список
// хешів неможливо. Без цього пароль перестав би бути паролем.
//
// ─── ОДИН ВУЗОЛ — ОДИН ПИСЬМЕННИК ────────────────────────────────────────────
//
// library, state, ack пише лише господар; cmd — будь-хто на дошці, і ЛИШЕ
// створити; presence — кожен про себе. Саме це й дозволяє звузити кожен дозвіл
// до автора замість «будь-хто авторизований».
//
// $other: false СТОЇТЬ НА КОЖНОМУ ВУЗЛІ З ВІДОМОЮ ФОРМОЮ. Перевірка .validate
// стосується лише НАЗВАНИХ полів: без цього рядка запис міг би принести зайве
// поле, а головне — розбіжність імені поля між кодом і правилом лишалася б
// тихою. У сусідньому проєкті правило валідувало last_changed, код писав
// lastChanged, і захист не діяв ні на що: справжнє поле проходило як невідоме.
{
	"rules": {
		".read": false,
		".write": false,

		"boards": {
			// Дозволу читати тут НЕМАЄ навмисно — див. коментар вище.
			"$key": {
				// Хто знає адресу — той знає пару (ідентифікатор, пароль). Це і є вхід.
				".read": "auth != null",

				// Знести дошку цілком може лише господар — І ТІЛЬКИ ЗНЕСТИ.
				// Умова !newData.exists() не дає під виглядом видалення переписати
				// вміст: без неї те саме правило дозволяло б замінити весь вузол.
				".write": "auth != null && !newData.exists() && data.child('info/ownerUid').val() === auth.uid",

				"info": {
					// Створити може будь-хто авторизований, але тільки назвавши
					// господарем СЕБЕ. Далі міняти — лише господареві.
					//
					// Формат ключа перевіряється саме тут: дошка з’являється в базі рівно
					// через створення info, тож звуження в одному місці не дає засмічувати
					// boards довільними вузлами.
					".write": "auth != null && $key.matches(/^[0-9a-f]{32}$/) && (data.exists() ? data.child('ownerUid').val() === auth.uid : newData.child('ownerUid').val() === auth.uid)",
					// `seenAt` у переліку обов'язкових НЕМАЄ навмисно: дошки, створені
					// старішою збіркою, його не мають, і вимога зробила б кожен їхній
					// наступний запис невалідним.
					".validate": "newData.hasChildren(['name', 'ownerUid', 'createdAt', 'schema'])",
					"name": { ".validate": "newData.isString() && newData.val().length <= 60" },
					"ownerUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
					// Час ставить сервер: serverTimestamp() розкривається ДО валідації,
					// тож вікно навколо now відкидає підроблене число.
					"createdAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					// ПОЗНАЧКА «ДОШКОЮ КОРИСТУЮТЬСЯ», від якої рахується вік при
					// прибиранні (src/lib/board/boardLifetime.ts). Пише її плеєр при
					// кожному відкритті, тобто на відміну від createdAt вона оновлюється
					// все життя дошки — звідси й окреме вікно навколо now.
					//
					// Підробити «свіжість» не можна: serverTimestamp() розкривається до
					// валідації, а число з майбутнього чи з минулого відкидається. Це
					// важить, бо від цього поля залежить НЕЗВОРОТНЕ видалення: без вікна
					// дошку можна було б або зробити вічною, або зістарити чужу на рік
					// уперед.
					"seenAt": {
						".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() > now - 60000"
					},
					"schema": { ".validate": "newData.isNumber() && newData.val() >= 1" },
					"$other": { ".validate": false }
				},

				"library": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['rev'])",
					"rev": { ".validate": "newData.isNumber()" },
					"tracks": {
						"$trackId": {
							// Порядок, клавіша й колір їдуть У ЗАПИСІ ТРЕКУ, а не окремими
							// вузлами: `tracks` — мапа, і порядку в ній немає, а два різні
							// вузли про той самий трек розходилися б при кожному перечитуванні
							// теки. Джерело всіх трьох — файл `audioremote.json` у самій теці.
							".validate": "newData.hasChildren(['title', 'path', 'order'])",
							"order": { ".validate": "newData.isNumber() && newData.val() >= 0" },
							// КОД клавіші, а не символ і не число: `KeyQ`, `F5`, `Numpad3`.
							"hotkey": {
								".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,20}$/)"
							},
							// Назва заготовки, а не код кольору: коротку назву можна перевірити.
							"color": {
								".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
							},
							// Значок перед назвою. Перевіряється лише довжина: емодзі буває
							// складеним (прапор — чотири одиниці коду, родина — вісім), і
							// вираз, який намагався б описати «саме емодзі», відкидав би
							// половину справжніх.
							"icon": { ".validate": "newData.isString() && newData.val().length <= 16" },
							// Чи запускається трек за зовнішнім API. САМ тригер сюди не їде
							// ніколи: у ньому чужа адреса й ключ доступу, а бібліотеку читає
							// кожен пульт.
							"auto": { ".validate": "newData.isBoolean()" },
							// ПІДПИС клавіші, яку порахував приймач, — не код і не число.
							// Пульт не рахує номери сам: трек «лише приймач» займає свою
							// цифру там і сюди не їде, тож власний рахунок пульта розійшовся
							// б із тим, що на екрані в залі.
							"key": { ".validate": "newData.isString() && newData.val().length <= 12" },
							"title": { ".validate": "newData.isString() && newData.val().length <= 200" },
							// Довжина шляху обмежена не з міркувань місця, а тому, що це
							// рядок із чужої файлової системи: межа мусить бути хоч якась.
							"path": { ".validate": "newData.isString() && newData.val().length <= 400" },
							"durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
							"$other": { ".validate": false }
						}
					},
					"$other": { ".validate": false }
				},

				"state": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['playing', 'armed'])",
					"trackId": { ".validate": "newData.isString() && newData.val().length <= 64" },
					"playing": { ".validate": "newData.isBoolean()" },
					"armed": { ".validate": "newData.isBoolean()" },
					"positionMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
					// Доба в мілісекундах — та сама межа, що й у перемотки.
					"durationMs": {
						".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
					},
					"atServer": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
					"volume": {
						".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
					},
					"$other": { ".validate": false }
				},

				// ─── ІНФОДОШКА ────────────────────────────────────────────────
				//
				// Другий вид дошки: замість файлів — сітка підписаних органів, а
				// замість відтворення — рядок на екрані того, хто за пультом.
				// Механіка підключення спільна цілком, тож нових гілок лише дві.
				//
				// `panel` — ЩО намальовано. Пише господар; адміністратор просить
				// зміни командою у своєму каналі, як і в аудіодошці.
				//
				// `panelState` — ЯК СТОЯТЬ органи зараз. Пише ТЕЖ господар, і це
				// головне рішення цієї гілки. Повідомлення мусить казати «було 40
				// стало 60», тобто обидві сторони зобов'язані бачити одне й те саме
				// «було». Якби стан писав кожен, хто торкнувся повзунка, вузол мав
				// би багатьох письменників — і правило довелося б послабити до
				// «будь-хто на дошці», тобто до того, чого в цій схемі немає ніде.
				"panel": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['rev'])",
					"rev": { ".validate": "newData.isNumber() && newData.val() >= 0" },
					// РОЗМІР САМОЇ ДОШКИ. Немає — три на п'ять, як було завжди.
					// Межі не косметичні: понад шість стовпців комірка на телефоні
					// стає вужчою за палець, понад вісім рядів сітка не вміщається в
					// екран без прокрутки, а прокрутка вбиває натискання наосліп.
					"cols": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6" },
					"rows": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
					"cells": {
						// Ключ — номер комірки сітки 3×5, тобто 0…14 і нічого іншого.
						"$cell": {
							".validate": "$cell.matches(/^([0-9]|[1-3][0-9]|4[0-7])$/) && newData.hasChildren(['kind'])",
							"kind": { ".validate": "newData.val().matches(/^(buttons|slider|check)$/)" },
							"caption": { ".validate": "newData.isString() && newData.val().length <= 24" },
							// Назва заготовки, а не код кольору: перелік живе в коді, і
							// довільний рядок кольору правилом не перевіриш. Форма — та сама,
							// що в кольору треку вище й у `COLOR_SLUG` у джерелах; що всі три
							// збігаються, стереже `src/db-sources.test.ts`.
							"color": {
								".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
							},
							"icon": { ".validate": "newData.isString() && newData.val().length <= 16" },
							// Чий це пульт. Порожнього поля тут не буває: спільний віджет
							// просто не має цього поля взагалі (`panelTypes.ts`).
							"sheet": { ".validate": "newData.isString() && newData.val().length <= 16" },
							"step": {
								".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
							},
							// Стовпчиком чи рядком. Скільки клітинок займе віджет, рахує
							// клієнт (`panel/layout.ts`): сітка — не дані, а розкладка.
							"vertical": { ".validate": "newData.isBoolean()" },
							// Свій розмір у клітинках. Межі — сама сітка 3×5; чи не
							// наступає віджет на сусіда, однаково вирішує клієнт.
							"rows": {
								".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
							},
							"cols": {
								".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
							},
							// Гучне натискання: спалах на весь екран табла.
							"important": { ".validate": "newData.isBoolean()" },
							"buttons": {
								// Не більше п'яти: стільки рядів у сітці, тобто віджет
								// стовпчиком може бути заввишки з колонку й не довше.
								"$index": {
									".validate": "$index.matches(/^[0-4]$/) && newData.hasChildren(['label'])",
									"label": { ".validate": "newData.isString() && newData.val().length <= 24" },
									// Свій колір кнопки — назва заготовки, як і в віджета.
									"color": {
										".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
									},
									"$other": { ".validate": false }
								}
							},
							"$other": { ".validate": false }
						}
					},
					"$other": { ".validate": false }
				},

				"panelState": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['atServer'])",
					"atServer": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
					"levels": {
						"$cell": {
							".validate": "$cell.matches(/^([0-9]|[1-3][0-9]|4[0-7])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
						}
					},
					"flags": {
						"$cell": {
							".validate": "$cell.matches(/^([0-9]|[1-3][0-9]|4[0-7])$/) && newData.isBoolean()"
						}
					},
					// ЩО НАТИСНУЛИ ОСТАННІМ — рівно та сама трійка, що в команді, і
					// рівно з тими самими межами. Їде тут, а не своїм вузлом, бо
					// письменник той самий (господар) і вузол однаково пишеться цілком
					// на кожне натискання; свіжість каже `atServer` поруч.
					"press": {
						".validate": "newData.hasChildren(['cell', 'type'])",
						"cell": { ".validate": "newData.val().matches(/^([0-9]|[1-3][0-9]|4[0-7])$/)" },
						"type": { ".validate": "newData.val().matches(/^(press|bump|toggle)$/)" },
						"value": {
							".validate": "newData.isNumber() && ((newData.parent().child('type').val() === 'press' && newData.val() >= 0 && newData.val() <= 4) || (newData.parent().child('type').val() === 'bump' && newData.val() >= -50 && newData.val() <= 50))"
						},
						"$other": { ".validate": false }
					},
					"$other": { ".validate": false }
				},
				// `panelVerdict` — ЩО ЗВУКОРЕЖИСЕР ВІДПОВІВ на останнє прохання.
				// Письменник знову той самий, господар: відповідь — це його слово,
				// і право сказати його за нього не має ніхто. Вузол один, а не
				// журнал: питання «що зі мною щойно погодилися зробити» має рівно
				// одну відповідь — останню.
				"panelVerdict": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['kind', 'cell', 'at'])",
					"kind": { ".validate": "newData.val().matches(/^(done|no|wait)$/)" },
					"cell": { ".validate": "newData.val().matches(/^([0-9]|[1-3][0-9]|4[0-7])$/)" },
					"caption": { ".validate": "newData.isString() && newData.val().length <= 24" },
					"at": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
					"$other": { ".validate": false }
				},
				"cmd": {
					"$id": {
						// «ЛИШЕ СТВОРИТИ» — і одразу дві властивості одним рядком: команду
						// не переписати й не підписати чужим uid.
						//
						// Друга половина правила — видалення господарем: приймач прибирає
						// команду, щойно виконав її. Без цього журнал ріс би вічно, а
						// onChildAdded при перепідключенні віддавав би його весь.
						//
						// info/ownerUid мусить існувати: інакше команди можна було б сипати
						// у вузли неіснуючих дощок і засмічувати базу.
						".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && root.child('boards/' + $key + '/info/ownerUid').exists()) || (!newData.exists() && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid))",
						".validate": "newData.hasChildren(['by', 'type', 'at'])",
						"by": { ".validate": "newData.isString() && newData.val().length <= 128" },
						"type": {
							// Два набори в одному регексі, бо канал і журнал спільні для обох
							// видів дошки: перші вісім — звук, останні три — інфодошка.
							".validate": "newData.isString() && newData.val().matches(/^(play|pause|resume|stop|prev|next|volume|seek|press|bump|toggle)$/)"
						},
						// Рядок або число, і межа числа ЗАЛЕЖИТЬ ВІД ТИПУ: `volume` несе
						// відсотки, `seek` — позицію в мілісекундах, `press` — номер кнопки,
						// `bump` — крок повзунка, ЗНАКОВИЙ. Одна спільна межа означала б або
						// гучність 86 мільйонів, або перемотку на сто мілісекунд.
						//
						// ПЕРЕЛІК, А НЕ ЛАНЦЮЖОК ТЕРНАРНИХ. Спершу тут стояв ланцюжок із
						// запасною гілкою «решта чисел до 86400000», і на ньому `bump` зі
						// значенням -5 відхилявся, хоч гілка для нього була написана. Плаский
						// перелік читається очима й заразом суворіший: тип, якого тут немає,
						// числа не несе взагалі.
						"value": {
							".validate": "(newData.isString() && newData.val().length <= 64) || (newData.isNumber() && ((newData.parent().child('type').val() === 'volume' && newData.val() >= 0 && newData.val() <= 100) || (newData.parent().child('type').val() === 'seek' && newData.val() >= 0 && newData.val() <= 86400000) || (newData.parent().child('type').val() === 'press' && newData.val() >= 0 && newData.val() <= 4) || (newData.parent().child('type').val() === 'bump' && newData.val() >= -50 && newData.val() <= 50)))"
						},
						// Час серверний. Без вікна навколо now пульт міг би написати команду
						// «з майбутнього», і межа життя команди не спрацювала б ніколи.
						"at": {
							".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() > now - 60000"
						},
						// Номер комірки інфодошки. У звукових командах його просто немає:
						// поле необов'язкове, а форма — та сама, що в ключах панелі.
						"cell": {
							".validate": "newData.isString() && newData.val().matches(/^([0-9]|[1-3][0-9]|4[0-7])$/)"
						},
						// Як підписався той, хто натиснув. ПІДПИС, А НЕ ПОСВІДЧЕННЯ: база
						// його не звіряє ні з чим і не може — вхід анонімний. Межа тут
						// лише на довжину, щоб рядок журналу лишався рядком.
						"name": { ".validate": "newData.isString() && newData.val().length <= 24" },
						"$other": { ".validate": false }
					}
				},

				"ack": {
					".write": "auth != null && root.child('boards/' + $key + '/info/ownerUid').val() === auth.uid",
					"$id": {
						".validate": "!newData.exists() || newData.hasChildren(['ok', 'at'])",
						"ok": { ".validate": "newData.isBoolean()" },
						"error": { ".validate": "newData.isString() && newData.val().length <= 64" },
						"at": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
						"$other": { ".validate": false }
					}
				},

				"presence": {
					"$uid": {
						// Кожен пише лише про себе. Дошка мусить існувати.
						//
						// Дозвіл стоїть на рівні $uid і ПОШИРЮЄТЬСЯ на все, що під ним,
						// — тому додатковий рівень вкладки нижче нічого не послаблює:
						// написати під чужим $uid так само не можна.
						".write": "auth != null && $uid === auth.uid && root.child('boards/' + $key + '/info/ownerUid').exists()",
						"$tab": {
							// ДРУГИЙ РІВЕНЬ — ВКЛАДКА, і він з'явився із заміру.
							//
							// Анонімний вхід дає всім вкладкам одного браузера той самий
							// uid. Поки присутність лежала просто в presence/{uid}, друга
							// вкладка перетирала першу: плеєр і пульт, відкриті на одному
							// комп'ютері, давали «комп'ютер офлайн» при живому плеєрі.
							//
							// Видалення (null) під .validate не потрапляє — це навмисно:
							// саме так прибирає запис onDisconnect на боці сервера.
							".validate": "newData.hasChildren(['role', 'at'])",
							"role": {
								".validate": "newData.isString() && newData.val().matches(/^(player|remote)$/)"
							},
							"at": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
							// ХТО САМЕ ТУТ І ЗА ЯКИМ ПУЛЬТОМ. Обидва поля необовʼязкові:
							// анонімний помічник, який дивиться всю дошку, лишає той самий
							// запис, що й раніше. Межі ті самі, що в підпису команди й у
							// назві пульта на віджеті — числа не мають розходитися.
							"name": { ".validate": "newData.isString() && newData.val().length <= 24" },
							"sheet": { ".validate": "newData.isString() && newData.val().length <= 16" },
							"$other": { ".validate": false }
						}
					}
				},

				"$other": { ".validate": false }
			}
		},

		// ─── АДМІНСЬКИЙ КАНАЛ ────────────────────────────────────────────────
		//
		// Третя роль: пульт, який міняє налаштування дошки так само, як людина за
		// самим комп'ютером. Другий пароль перевіряється тим самим єдиним
		// способом, який тут узагалі працює, — він ВХОДИТЬ В АДРЕСУ каналу
		// (див. `deriveAdminKey`).
		//
		// ЧОМУ ОКРЕМА ГІЛКА, А НЕ ВУЗОЛ УСЕРЕДИНІ ДОШКИ. Дозвіл читати стоїть на
		// boards/$key і поширюється на ВСЕ піддерево — відкликати його глибше
		// правила не вміють. Тобто канал, покладений усередину, прочитав би
		// будь-хто з паролем дошки, і другий пароль не означав би нічого.
		//
		// Перелічити admin, як і boards, не можна: дозволу на самій гілці немає.
		"admin": {
			"$akey": {
				// Хто знає адресу — той знає адмінський пароль. Це і є вхід.
				// Звідси ж і перевірка пароля на боці пульта: канал або є, або його
				// немає, і відповідає на це база, а не наш if.
				".read": "auth != null",

				// Знести канал (тобто вимкнути адмінський доступ) може лише
				// господар — І ТІЛЬКИ ЗНЕСТИ, як і саму дошку.
				".write": "auth != null && !newData.exists() && data.child('info/ownerUid').val() === auth.uid",

				"info": {
					".write": "auth != null && $akey.matches(/^[0-9a-f]{32}$/) && (data.exists() ? data.child('ownerUid').val() === auth.uid : newData.child('ownerUid').val() === auth.uid)",
					".validate": "newData.hasChildren(['ownerUid', 'createdAt', 'schema'])",
					"ownerUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
					"createdAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"schema": { ".validate": "newData.isNumber() && newData.val() >= 1" },
					"$other": { ".validate": false }
				},

				// ПОВНІ НАЛАШТУВАННЯ ТРЕКІВ — те, чого немає в `library`.
				//
				// У бібліотеку вони не годяться: там їх бачив би кожен пульт, а серед
				// них є заголовки запиту до чужого API, тобто чужий ключ доступу.
				// Тут їх бачить лише той, хто знає адресу каналу.
				//
				// Одним рядком JSON, а не деревом, і це свідомо: форму налаштувань
				// (тригер із тижневим розкладом усередині) правила повторювали б
				// удвічі довше за самі правила, і розходилися б із кодом мовчки. Той,
				// хто сюди пише, уже довів знання пароля адресою; те, що він написав,
				// однаково перевіряє плеєр, перш ніж покласти у файл.
				"tracks": {
					".write": "auth != null && root.child('admin/' + $akey + '/info/ownerUid').val() === auth.uid",
					".validate": "newData.hasChildren(['rev', 'json'])",
					"rev": { ".validate": "newData.isNumber() && newData.val() >= 0" },
					"json": { ".validate": "newData.isString() && newData.val().length <= 300000" },
					"$other": { ".validate": false }
				},

				// Ті самі два правила, що й у команд дошки: «лише створити», і
				// прибирає виконане господар.
				"cmd": {
					"$id": {
						".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && root.child('admin/' + $akey + '/info/ownerUid').exists()) || (!newData.exists() && root.child('admin/' + $akey + '/info/ownerUid').val() === auth.uid))",
						".validate": "newData.hasChildren(['by', 'type', 'at'])",
						"by": { ".validate": "newData.isString() && newData.val().length <= 128" },
						"type": {
							".validate": "newData.isString() && newData.val().matches(/^(tracks|rescan)$/)"
						},
						"value": { ".validate": "newData.isString() && newData.val().length <= 300000" },
						"at": {
							".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() > now - 60000"
						},
						"$other": { ".validate": false }
					}
				},

				"ack": {
					".write": "auth != null && root.child('admin/' + $akey + '/info/ownerUid').val() === auth.uid",
					"$id": {
						".validate": "!newData.exists() || newData.hasChildren(['ok', 'at'])",
						"ok": { ".validate": "newData.isBoolean()" },
						"error": { ".validate": "newData.isString() && newData.val().length <= 64" },
						"at": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
						"$other": { ".validate": false }
					}
				},

				"$other": { ".validate": false }
			}
		}
	}
}
