# Бойовий проєкт Firebase. Копіюється в `.env` або задається змінними в CI.
#
# УВАГА: ці значення публічні за побудовою — вони лежать у бандлі, і приховати
# їх неможливо. Єдина межа безпеки — `database.rules.json`, який перевіряється
# гейтом `npm run check:rules`.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# ОБОВ'ЯЗКОВА. Без неї SDK іде на типову американську адресу
# `<projectId>-default-rtdb.firebaseio.com`, якої в цього проєкту немає, а CSP
# її не дозволяє. Симптому «не та адреса» SDK не дає: він просто йде за нею.
VITE_FIREBASE_DATABASE_URL=
