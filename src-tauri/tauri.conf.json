{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "AudioRemote",
	"version": "0.1.0",
	"identifier": "ua.odesa.audioremote",
	"build": {
		"frontendDist": "https://alik532ua.github.io/AudioRemote/"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"url": "https://alik532ua.github.io/AudioRemote/",
				"title": "AudioRemote — приймач",
				"width": 1280,
				"height": 860,
				"minWidth": 380,
				"minHeight": 480,
				"resizable": true,
				"center": true
			}
		],
		"security": {
			"csp": null,
			"capabilities": ["default"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
